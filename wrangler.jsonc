{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",

  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": "./public"
  },

  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "nlng-predictive-maintenance"
    }
  ],

  "secrets": {
    "required": [
      "DATASET_TOKEN"
    ]
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}
